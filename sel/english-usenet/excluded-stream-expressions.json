[
  {
    "expression": "/* Usenet only */ negate(type(streams, 'usenet', 'stremio-usenet'), streams)",
    "enabled": true
  },
  {
    "expression": "/* Resolution: 2160p / 1080p / 720p */ negate(resolution(streams, '2160p', '1080p', '720p'), streams)",
    "enabled": true
  },
  {
    "expression": "/* Audio: English */ negate(language(streams, 'English'), streams)",
    "enabled": true
  },
  {
    "expression": "/* Exclude AV1 (unsupported by clients) */ encode(streams, 'AV1')",
    "enabled": true
  },
  {
    "expression": "/* 720p only when fewer than 5 x 1080p */ count(resolution(streams, '1080p')) >= 5 ? resolution(streams, '720p') : []",
    "enabled": true
  }
]
